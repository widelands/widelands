msgstr "שרידיו של עץ ישן."

#. TRANSLATORS: Helptext for an Amazon immovable: Balsa Tree Sapling
#: ../../../../data/tribes/initialization/amazons/units.lua:802
#: ../../../../data/tribes/initialization/amazons/units.lua:830
#: ../../../../data/tribes/initialization/amazons/units.lua:858
#: ../../../../data/tribes/initialization/amazons/units.lua:886
msgid "This balsa tree has just been planted."
msgstr "עץ הבלסה הזה נשתל זה עתה."

#. TRANSLATORS: Helptext for an Amazon immovable: Balsa Tree Pole
#: ../../../../data/tribes/initialization/amazons/units.lua:809
#: ../../../../data/tribes/initialization/amazons/units.lua:837
#: ../../../../data/tribes/initialization/amazons/units.lua:865
#: ../../../../data/tribes/initialization/amazons/units.lua:893
msgid "This balsa tree is growing."
msgstr "עץ הבלסה הזה גדל."

#. TRANSLATORS: Helptext for an Amazon immovable: Balsa Tree Mature
#: ../../../../data/tribes/initialization/amazons/units.lua:816
#: ../../../../data/tribes/initialization/amazons/units.lua:844
#: ../../../../data/tribes/initialization/amazons/units.lua:872
#: ../../../../data/tribes/initialization/amazons/units.lua:900
msgid "This balsa tree is fully grown. Lianas can be gathered from it."
msgstr "עץ הבלסה הזה בוגר במלואו. אפשר לאסוף ממנו ליאנות."

#. TRANSLATORS: Helptext for an Amazon immovable: Balsa Tree Old
#: ../../../../data/tribes/initialization/amazons/units.lua:823
#: ../../../../data/tribes/initialization/amazons/units.lua:851
#: ../../../../data/tribes/initialization/amazons/units.lua:879
#: ../../../../data/tribes/initialization/amazons/units.lua:907
msgid ""
"This balsa tree is ready for harvesting balsa wood by a master woodcutter. "
"Other tribes can harvest it for normal logs."
msgstr "עץ הבלסה הזה מוכן לקצירת עץ בלסה בידי רב-כורתים. שבטים אחרים יכולים לקצור ממנו בולי עץ רגילים."

#. TRANSLATORS: Helptext for an Amazon immovable: Ironwood Tree Sapling
#: ../../../../data/tribes/initialization/amazons/units.lua:914
#: ../../../../data/tribes/initialization/amazons/units.lua:942
#: ../../../../data/tribes/initialization/amazons/units.lua:970
#: ../../../../data/tribes/initialization/amazons/units.lua:998
msgid "This ironwood tree has just been planted."
msgstr "עץ הברזל הזה נשתל זה עתה."

#. TRANSLATORS: Helptext for an Amazon immovable: Ironwood Tree Pole
#: ../../../../data/tribes/initialization/amazons/units.lua:921
#: ../../../../data/tribes/initialization/amazons/units.lua:949
#: ../../../../data/tribes/initialization/amazons/units.lua:977
#: ../../../../data/tribes/initialization/amazons/units.lua:1005
msgid "This ironwood tree is growing."
msgstr "עץ הברזל הזה גדל."

