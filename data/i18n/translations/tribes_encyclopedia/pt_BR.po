msgid "A belated scout’s report"
msgstr "Um relatório atrasado de batedor"

#: ../../../../data/tribes/initialization/empire/units.lua:1432
msgctxt "empire_building"
msgid ""
"You need to connect this flag to a scout’s house before you can send a scout"
" here."
msgstr "Você precisa conectar esta bandeira a uma cabana do batedor antes de poder enviar um batedor para cá."

#. TRANSLATORS: Performance helptext for an Empire production site: Scout's
#. House, part 1
#: ../../../../data/tribes/initialization/empire/units.lua:1437
msgctxt "empire_building"
msgid "One exploration trip of the scout takes between %1$s and %2$s."
msgstr "Uma viagem de exploração do escoteiro leva entre %1$s e %2$s."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "The mind moves boulders."
#: ../../../../data/tribes/initialization/empire/units.lua:1452
