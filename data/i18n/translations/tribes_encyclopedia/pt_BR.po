#: ../../../../data/tribes/initialization/amazons/units.lua:1375
#: ../../../../data/tribes/initialization/amazons/units.lua:1394
#: ../../../../data/tribes/initialization/amazons/units.lua:1407
#: ../../../../data/tribes/initialization/amazons/units.lua:1422
