#. TRANSLATORS: Performance helptext for an Empire production site: Brewery
#: ../../../../data/tribes/initialization/empire/units.lua:1548
msgctxt "empire_building"
msgid "The brewer needs %1% on average to brew a vat of beer."
msgstr "O cervejeiro precisa de %1% em média para fabricar um tonel de cerveja."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Good wine needs no bush." (meaning no advertising)
#: ../../../../data/tribes/initialization/empire/units.lua:1558
msgid "Vino vendibili hedera non opus est."
msgstr "Vino vendibili hedera non opus est."

#. TRANSLATORS: Lore helptext for an Empire production site: Vineyard
#. Translation for the classical Latin quote:
#. "Vino vendibili hedera non opus est."
#. Bush (ivy in the original) refers to the ivy leaves used for advertising
#. by places selling wine
#: ../../../../data/tribes/initialization/empire/units.lua:1564
msgid "Good wine needs no bush."
msgstr "Bom vinho não precisa de letreiro."

#. TRANSLATORS: Lore author helptext for an Empire production site: Vineyard
#: ../../../../data/tribes/initialization/empire/units.lua:1567
msgctxt "empire_building"
msgid "A proud vine farmer boasting"
msgstr "Um cultivador de vinhas orgulhoso se gabando"

#. TRANSLATORS: Purpose helptext for an Empire production site: Vineyard
#: ../../../../data/tribes/initialization/empire/units.lua:1569
msgctxt "empire_building"
msgid "Plants grapevines and harvests grapes."
msgstr "Planta videiras e colhe uvas."

#. TRANSLATORS: Performance helptext for an Empire production site: Vineyard,
#. part 1
#: ../../../../data/tribes/initialization/empire/units.lua:1572
msgctxt "empire_building"
msgid ""
"The vine farmer sows and harvests one basket of grapes between %1$s and "
"%2$s, depending on how far he has to walk."
msgstr "O cultivador de vinhas semeia e colhe uma cesta de uvas entre %1$s e %2$s, dependendo de quão longe ele tem que andar."

#. TRANSLATORS: Performance helptext for an Empire production site: Vineyard,
#. part 2; %s is replaced by 'N growing fields'
#: ../../../../data/tribes/initialization/empire/units.lua:1574
#, lua-format
msgctxt "empire_building"
msgid ""
"The vineyard needs at least %s to work at full productivity most of the "
"time."
msgstr "O vinhedo precisa de pelo menos %s para trabalhar com produtividade total na maior parte do tempo."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "In wine there is truth."
#: ../../../../data/tribes/initialization/empire/units.lua:1585
msgid "In vino veritas."
msgstr "In vino veritas."

#. TRANSLATORS: Lore helptext for an Empire production site: Winery
#. Translation for the classical Latin quote:
#. "In vino veritas."
#: ../../../../data/tribes/initialization/empire/units.lua:1589
msgid "In wine there is truth."
msgstr "No vinho está a verdade."

