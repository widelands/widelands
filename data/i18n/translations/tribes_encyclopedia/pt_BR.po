#. TRANSLATORS: Lore author helptext for an Empire training site: Training
#. Camp
#: ../../../../data/tribes/initialization/empire/units.lua:2153
msgctxt "empire_building"
msgid "Trainer to soldiers who questioned the need for higher level training"
msgstr "Treinador a soldados que questionaram a necessidade de treinamento de nível superior"

#. TRANSLATORS: Purpose helptext for an Empire training site: Training Camp,
#. part 1
#: ../../../../data/tribes/initialization/empire/units.lua:2157
msgctxt "empire_building"
msgid "Trains soldiers in ‘Attack’ and in ‘Health’."
msgstr "Treinar soldados para \"Escapar\"."

#. TRANSLATORS: Purpose helptext for an Empire training site: Training Camp,
#. part 2
#: ../../../../data/tribes/initialization/empire/units.lua:2159
msgctxt "empire_building"
msgid "Equips the soldiers with all necessary weapons and armor parts."
msgstr "Equipa os soldados com todas as armas e peças de armadura necessárias."

#. TRANSLATORS: Performance helptext for an Empire training site: Training
#. Camp, part 1
#: ../../../../data/tribes/initialization/empire/units.lua:2165
#, lua-format
msgctxt "empire_building"
msgid ""
"If all needed wares are delivered in time, a training camp can train one "
"soldier one level in attack or health in %s on average."
msgstr "Se todas as mercadorias necessárias forem entregues a tempo, um acampamento de treinamento pode treinar um soldado um nível de ataque ou vida em %s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
