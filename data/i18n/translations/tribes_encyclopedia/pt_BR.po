#. TRANSLATORS: Performance helptext for an Empire production site: Winery
#: ../../../../data/tribes/initialization/empire/units.lua:1596
#, lua-format
msgctxt "empire_building"
msgid "The winery needs %s on average to produce one wine."
msgstr "A vinícola precisa de %s em média para produzir um vinho."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "We eat to live, not live to eat."
#: ../../../../data/tribes/initialization/empire/units.lua:1606
msgid "Esse oportet ut vivas, non vivere ut edas."
msgstr "Esse oportet ut vivas, non vivere ut edas."

#. TRANSLATORS: Lore helptext for an Empire production site: Tavern
#. Translation for the classical Latin quote:
#. "Esse oportet ut vivas, non vivere ut edas."
#: ../../../../data/tribes/initialization/empire/units.lua:1610
msgid "We eat to live, not live to eat."
msgstr "Comemos para viver, não vivemos para comer."

#. TRANSLATORS: Lore author helptext for an Empire production site: Tavern
#: ../../../../data/tribes/initialization/empire/units.lua:1613
msgctxt "empire_building"
msgid "Warning to a gluttonous miner"
msgstr "Advertência a um minerador glutão"

#. TRANSLATORS: Performance helptext for an Empire production site: Tavern
#: ../../../../data/tribes/initialization/empire/units.lua:1617
msgctxt "empire_building"
msgid "The innkeeper needs %1% on average to prepare a ration."
msgstr "O estalajadeiro precisa de %1% em média para preparar uma ração."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "A meal full of dishes restrains your mind."
#: ../../../../data/tribes/initialization/empire/units.lua:1627
msgid "In cena dapibus plena te mente refrena."
msgstr "In cena dapibus plena te mente refrena."

#. TRANSLATORS: Lore helptext for an Empire production site: Inn
#. Translation for the classical Latin quote:
#. "In cena dapibus plena te mente refrena."
#: ../../../../data/tribes/initialization/empire/units.lua:1631
msgid "A meal full of dishes restrains your mind."
msgstr "Uma refeição cheia de pratos modera sua mente."

#. TRANSLATORS: Lore author helptext for an Empire production site: Inn
#: ../../../../data/tribes/initialization/empire/units.lua:1634
msgctxt "empire_building"
msgid "Warning from a master miner to an apprentice"
msgstr "Advertência de um minerador mestre a um aprendiz"

#. TRANSLATORS: Purpose helptext for an Empire production site: Inn
#: ../../../../data/tribes/initialization/empire/units.lua:1636
msgctxt "empire_building"
msgid ""
"Prepares rations for scouts and rations and meals to feed the miners in all "
"mines."
msgstr "Prepara rações para batedores e rações e refeições para alimentar os mineradores em todas as minas."

#. TRANSLATORS: Performance helptext for an Empire production site: Inn
#: ../../../../data/tribes/initialization/empire/units.lua:1638
msgctxt "empire_building"
msgid ""
"If this building is fully supplied and all kinds of food are needed by the "
"economy, production of one of each food takes %1$s on average. If only one "
"kind of food is needed by the economy, production of one ration takes %2$s "
"and one meal takes %3$s on average."
msgstr "Se esta construção estiver totalmente abastecida e todos os tipos de comida forem necessários à economia, a produção de um de cada alimento leva %1$s em média. Se apenas um tipo de comida for necessário à economia, a produção de uma ração leva %2$s e uma refeição leva %3$s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Are they to be marked with chalk or charcoal?"
#: ../../../../data/tribes/initialization/empire/units.lua:1648
msgid "Creta an carbone notandi?"
msgstr "Creta an carbone notandi?"

#. TRANSLATORS: Lore helptext for an Empire production site: Charcoal Kiln
#. Translation for the classical Latin quote:
#. "Creta an carbone notandi?"
#: ../../../../data/tribes/initialization/empire/units.lua:1652
msgid "Are they to be marked with chalk or charcoal?"
msgstr "Devem ser marcados com giz ou com carvão?"

#. TRANSLATORS: Lore author helptext for an Empire production site: Charcoal
#. Kiln
#: ../../../../data/tribes/initialization/empire/units.lua:1656
msgctxt "empire_building"
msgid "Imperial proverb meaning to judge whether they are good or bad"
msgstr "Provérbio imperial que significa julgar se são bons ou maus"

#. TRANSLATORS: Performance helptext for an Empire production site: Charcoal
#. Kiln
#: ../../../../data/tribes/initialization/empire/units.lua:1661
#, lua-format
msgctxt "empire_building"
msgid "The charcoal kiln needs %s on average to produce one coal."
msgstr "A casa do carvoeiro precisa de %s em média para produzir um carvão."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "I see that iron was produced from the same darkness as gold."
#: ../../../../data/tribes/initialization/empire/units.lua:1671
msgid "Video ferrum ex isdem tenebris esse prolatum, quibus aurum."
msgstr "Video ferrum ex isdem tenebris esse prolatum, quibus aurum."

#. TRANSLATORS: Lore helptext for an Empire production site: Smelting Works
#. Translation for the classical Latin quote:
#. "Video ferrum ex isdem tenebris esse prolatum, quibus aurum."
#: ../../../../data/tribes/initialization/empire/units.lua:1675
msgid "I see that iron was produced from the same darkness as gold."
msgstr "Vejo que o ferro foi produzido da mesma escuridão que o ouro."

#. TRANSLATORS: Lore author helptext for an Empire production site: Smelting
#. Works
#: ../../../../data/tribes/initialization/empire/units.lua:1678
msgctxt "empire_building"
msgid "Amalea after inspecting a smelting works"
msgstr "Amalea após inspecionar uma fundição"

#. TRANSLATORS: Performance helptext for an Empire production site: Smelting
#. Works
#: ../../../../data/tribes/initialization/empire/units.lua:1682
msgctxt "empire_building"
msgid ""
"If this building is fully supplied and all metals are needed by the economy,"
" production of one iron takes %1$s and one gold takes %2$s on average. If "
"only one kind of metal is needed by the economy, production of one iron "
"takes %3$s and one gold takes %4$s on average."
msgstr "Se esta construção estiver totalmente abastecida e todos os metais forem necessários à economia, a produção de um ferro leva %1$s e um ouro leva %2$s em média. Se apenas um tipo de metal for necessário à economia, a produção de um ferro leva %3$s e um ouro leva %4$s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Each man is the maker of his own fortune."
#: ../../../../data/tribes/initialization/empire/units.lua:1692
msgid "Faber est suæ quisque fortunæ."
msgstr "Faber est suæ quisque fortunæ."

#. TRANSLATORS: Lore helptext for an Empire production site: Toolsmithy
#. Translation for the classical Latin quote:
#. "Faber est suæ quisque fortunæ."
#: ../../../../data/tribes/initialization/empire/units.lua:1696
msgid "Each man is the maker of his own fortune."
msgstr "Cada homem é o autor de sua própria sorte."

#. TRANSLATORS: Lore author helptext for an Empire production site: Toolsmithy
#: ../../../../data/tribes/initialization/empire/units.lua:1699
msgctxt "empire_building"
msgid "Imperial proverb quoted in a toolsmith's advertising"
msgstr "Provérbio imperial citado na propaganda de um ferramenteiro"

#. TRANSLATORS: Performance helptext for an Empire production site: Toolsmithy
#: ../../../../data/tribes/initialization/empire/units.lua:1703
msgctxt "empire_building"
msgid ""
"If this building is fully supplied and all tools are needed by the economy, "
"production of one of each tool takes %1$s on average. If only one kind of "
"tool is needed by the economy, its production takes %2$s on average."
msgstr "Se esta construção estiver totalmente abastecida e todas as ferramentas forem necessárias à economia, a produção de uma de cada ferramenta leva %1$s em média. Se apenas um tipo de ferramenta for necessário à economia, sua produção leva %2$s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "They enjoy their great armors under their capes, tightly woven from rings,
#. rattling
#. through the cloth."
#: ../../../../data/tribes/initialization/empire/units.lua:1714
msgid ""
"Hi loricarum vasto sub tegmine gaudent, intexit creber sibimet quas circulus"
" hærens, atque catenosi crepitant per corpora panni."
msgstr "Hi loricarum vasto sub tegmine gaudent, intexit creber sibimet quas circulus hærens, atque catenosi crepitant per corpora panni."

#. TRANSLATORS: Lore helptext for an Empire production site: Armorsmithy
#. Translation for the classical Latin quote:
#. "Hi loricarum vasto sub tegmine gaudent, intexit creber sibimet quas
#. circulus hærens,
#. atque catenosi crepitant per corpora panni."
#: ../../../../data/tribes/initialization/empire/units.lua:1720
msgid ""
"They enjoy their great armors under their capes, tightly woven from rings, "
"rattling through the cloth."
msgstr "Eles ostentam suas grandes armaduras sob suas capas, tecidas apertadamente de anéis, tilintando através do tecido."

#. TRANSLATORS: Lore author helptext for an Empire production site:
#. Armorsmithy
#: ../../../../data/tribes/initialization/empire/units.lua:1724
msgctxt "empire_building"
msgid "An armorsmith teaching an apprentice"
msgstr "Um ferreiro de armaduras ensinando um aprendiz"

#. TRANSLATORS: Purpose helptext for an Empire production site: Armor Smithy
#: ../../../../data/tribes/initialization/empire/units.lua:1726
msgctxt "empire_building"
msgid ""
"Forges armor and helmets that are used for training soldiers’ health in the "
"training camp."
msgstr "Forja armaduras e elmos usados para treinar a vida dos soldados no acampamento de treinamento."

#. TRANSLATORS: Performance helptext for an Empire production site: Armor
#. Smithy
#: ../../../../data/tribes/initialization/empire/units.lua:1728
msgctxt "empire_building"
msgid ""
"If this building is fully supplied and all kinds of armor and helmets are "
"needed by the economy, production of one helmet takes %1$s and one of each "
"kind of armor takes %2$s on average. If only one kind of armor or helmets is"
" needed by the economy, production of one helmet takes %3$s, while one kind "
"of armor takes %4$s on average."
msgstr "Se esta construção estiver totalmente abastecida e todos os tipos de armaduras e elmos forem necessários à economia, a produção de um elmo leva %1$s e uma de cada tipo de armadura leva %2$s em média. Se apenas um tipo de armadura ou elmo for necessário à economia, a produção de um elmo leva %3$s, enquanto um tipo de armadura leva %4$s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Not walls but men protect the towns."
#: ../../../../data/tribes/initialization/empire/units.lua:1738
msgid "Non muri, sed viri sunt præsidium oppidorum."
msgstr "Non muri, sed viri sunt præsidium oppidorum."

#. TRANSLATORS: Lore helptext for an Empire production site: Barracks
#. Translation for the classical Latin quote:
#. "Non muri, sed viri sunt præsidium oppidorum."
#: ../../../../data/tribes/initialization/empire/units.lua:1742
msgid "Not walls but men protect the towns."
msgstr "Não são muros, mas homens que protegem as cidades."

#. TRANSLATORS: Lore author helptext for an Empire production site: Barracks
#: ../../../../data/tribes/initialization/empire/units.lua:1745
msgctxt "empire_building"
msgid "Argument in the Senate for increasing recruitment"
msgstr "Argumento no Senado para aumentar o recrutamento"

#. TRANSLATORS: Purpose helptext for an Empire production site: Barracks
#: ../../../../data/tribes/initialization/empire/units.lua:1747
msgctxt "empire_building"
msgid "Equips recruits and trains them as soldiers."
msgstr "Equipa recrutas e os treina como soldados."

#. TRANSLATORS: Performance helptext for an Empire production site: Barracks
#: ../../../../data/tribes/initialization/empire/units.lua:1749
#, lua-format
msgctxt "empire_building"
msgid "The barracks need %s on average to recruit one soldier."
msgstr "O quartel precisa de %s em média para recrutar um soldado."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "A donkey prefers straw to gold."
#: ../../../../data/tribes/initialization/empire/units.lua:1761
msgid "Asinus stramen mavult quam aurum."
msgstr "Asinus stramen mavult quam aurum."

#. TRANSLATORS: Lore helptext for an Empire production site: Donkey Farm
#. Translation for the classical Latin quote:
#. "Asinus stramen mavult quam aurum."
#: ../../../../data/tribes/initialization/empire/units.lua:1765
msgid "A donkey prefers straw to gold."
msgstr "Um jumento prefere palha a ouro."

#. TRANSLATORS: Lore author helptext for an Empire production site: Donkey
#. Farm
#: ../../../../data/tribes/initialization/empire/units.lua:1768
msgctxt "empire_building"
msgid "A donkey breeder during a shortage of wheat"
msgstr "Um criador de jumentos durante uma escassez de trigo"

#. TRANSLATORS: Purpose helptext for an Empire production site: Donkey Farm
#: ../../../../data/tribes/initialization/empire/units.lua:1770
msgctxt "empire_building"
msgid ""
"Breeds cute and helpful donkeys for adding them to the transportation "
"system."
msgstr "Cria jumentos fofos e prestativos para adicioná-los ao sistema de transporte."

#. TRANSLATORS: Performance helptext for an Empire production site: Donkey
#. Farm
#: ../../../../data/tribes/initialization/empire/units.lua:1772
#, lua-format
msgctxt "empire_building"
msgid ""
"If all needed wares are delivered in time, this building can produce a "
"donkey in %s on average."
msgstr "Se todas as mercadorias necessárias forem entregues a tempo, esta construção pode produzir um jumento em %s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Adaptation of a classical Latin quote meaning:
#. "Lutius had already removed himself from public affairs, he was living in
#. the countryside,
#. and the ambassadors of the senate found him while he was plowing his land."
#: ../../../../data/tribes/initialization/empire/units.lua:1783
msgid ""
"Lutius iam a publicis negotiis se removerat, ruri vivebat et senatus legati "
"eum invenerunt dum agellum suum arat."
msgstr "Lutius iam a publicis negotiis se removerat, ruri vivebat et senatus legati eum invenerunt dum agellum suum arat."

#. TRANSLATORS: Lore helptext for an Empire production site: Farm
#. Translation for the adapted classical Latin quote:
#. "Lutius iam a publicis negotiis se removerat, ruri vivebat et senatus
#. legati eum invenerunt
#. dum agellum suum arat."
#: ../../../../data/tribes/initialization/empire/units.lua:1789
msgid ""
"Lutius had already removed himself from public affairs, he was living in the"
" countryside, and the ambassadors of the senate found him while he was "
"plowing his land."
msgstr "Lutius já havia se afastado dos assuntos públicos, ele vivia no campo, e os embaixadores do senado o encontraram enquanto ele arava sua terra."

#. TRANSLATORS: Lore author helptext for an Empire production site: Farm
#: ../../../../data/tribes/initialization/empire/units.lua:1793
msgctxt "empire_building"
msgid "History of the Empire, Part VII"
msgstr "História do Império, Parte VII"

#. TRANSLATORS: Performance helptext for an Empire production site: Farm, part
#. 1
#: ../../../../data/tribes/initialization/empire/units.lua:1798
msgctxt "empire_building"
msgid ""
"The farmer sows and harvests one sheaf of wheat between %1$s and %2$s, "
"depending on how far he has to walk."
msgstr "O fazendeiro semeia e colhe um feixe de trigo entre %1$s e %2$s, dependendo de quão longe ele tem que andar."

#. TRANSLATORS: Performance helptext for an Empire production site: Farm, part
#. 2; %s is replaced by 'N growing fields'
#: ../../../../data/tribes/initialization/empire/units.lua:1800
#, lua-format
msgctxt "empire_building"
msgid ""
"The farm needs at least %s to work at full productivity most of the time."
msgstr "A fazenda precisa de pelo menos %s para trabalhar com produtividade total na maior parte do tempo."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "What does the pig really have other than meat?"
#: ../../../../data/tribes/initialization/empire/units.lua:1811
msgid "Sus vero quid habet præter escam?"
msgstr "Sus vero quid habet præter escam?"

#. TRANSLATORS: Lore helptext for an Empire production site: Piggery
#. Translation for the classical Latin quote:
#. "Sus vero quid habet præter escam?"
#: ../../../../data/tribes/initialization/empire/units.lua:1815
msgid "What does the pig really have other than meat?"
msgstr "O que o porco realmente tem além de carne?"

#. TRANSLATORS: Purpose helptext for an Empire production site: Piggery
#: ../../../../data/tribes/initialization/empire/units.lua:1820
msgctxt "empire_building"
msgid "Breeds pigs for their meat."
msgstr "Cria porcos por sua carne."

#. TRANSLATORS: Performance helptext for an Empire production site: Piggery
#: ../../../../data/tribes/initialization/empire/units.lua:1822
msgctxt "empire_building"
msgid "The pig breeder needs %1% on average to raise and slaughter a pig."
msgstr "O criador de porcos precisa de %1% em média para criar e abater um porco."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Try to rescue a lamb from a wolf."
#: ../../../../data/tribes/initialization/empire/units.lua:1832
msgid "Conari agnum eripere lupo."
msgstr "Conari agnum eripere lupo."

#. TRANSLATORS: Lore helptext for an Empire production site: Sheep Farm
#. Translation for the classical Latin quote:
#. "Conari agnum eripere lupo."
#: ../../../../data/tribes/initialization/empire/units.lua:1836
msgid "Try to rescue a lamb from a wolf."
msgstr "Tentar resgatar um cordeiro de um lobo."

#. TRANSLATORS: Lore author helptext for an Empire production site: Sheep Farm
#: ../../../../data/tribes/initialization/empire/units.lua:1839
msgctxt "empire_building"
msgid "Imperial proverb for trying the impossible"
msgstr "Provérbio imperial para tentar o impossível"

#. TRANSLATORS: Purpose helptext for an Empire production site: Sheep Farm
#: ../../../../data/tribes/initialization/empire/units.lua:1841
msgctxt "empire_building"
msgid "Keeps sheep for their wool."
msgstr "Cria ovelhas por sua lã."

#. TRANSLATORS: Performance helptext for an Empire production site: Sheep Farm
#: ../../../../data/tribes/initialization/empire/units.lua:1843
#, lua-format
msgctxt "empire_building"
msgid "The sheep farm needs %s on average to produce one wool."
msgstr "A fazenda de ovelhas precisa de %s em média para produzir uma lã."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Clothes make a man."
#: ../../../../data/tribes/initialization/empire/units.lua:1853
msgid "Vestis virum reddit."
msgstr "Vestis virum reddit."

#. TRANSLATORS: Lore helptext for an Empire production site: Weaving Mill
#. Translation for the classical Latin quote:
#. "Vestis virum reddit."
#: ../../../../data/tribes/initialization/empire/units.lua:1857
msgid "Clothes make a man."
msgstr "As roupas fazem o homem."

#. TRANSLATORS: Lore author helptext for an Empire production site: Weaving
#. Mill
#: ../../../../data/tribes/initialization/empire/units.lua:1860
msgctxt "empire_building"
msgid "Motto of the Weavers’ Guild"
msgstr "Lema da Guilda dos Tecelões"

#. TRANSLATORS: Purpose helptext for an Empire production site: Weaving Mill
#: ../../../../data/tribes/initialization/empire/units.lua:1862
msgctxt "empire_building"
msgid "Weaves cloth out of wool."
msgstr "Tece tecido a partir de lã."

#. TRANSLATORS: Performance helptext for an Empire production site: Weaving
#. Mill
#: ../../../../data/tribes/initialization/empire/units.lua:1864
#, lua-format
msgctxt "empire_building"
msgid "The weaving mill needs %s on average to produce one cloth."
msgstr "A tecelagem precisa de %s em média para produzir um tecido."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "The fire keeps its heat even in the iron."
#: ../../../../data/tribes/initialization/empire/units.lua:1874
msgid "Ignis calorem suum etiam in ferro tenet."
msgstr "Ignis calorem suum etiam in ferro tenet."

#. TRANSLATORS: Lore helptext for an Empire production site: Weapon Smithy
#. Translation for the classical Latin quote:
#. "Ignis calorem suum etiam in ferro tenet."
#: ../../../../data/tribes/initialization/empire/units.lua:1878
msgid "The fire keeps its heat even in the iron."
msgstr "O fogo mantém seu calor mesmo no ferro."

#. TRANSLATORS: Lore author helptext for an Empire production site: Weapon
#. Smithy
#: ../../../../data/tribes/initialization/empire/units.lua:1881
msgctxt "empire_building"
msgid "Motto of the Weaponsmiths’ Guild"
msgstr "Lema da Guilda dos Ferreiros de Armas"

#. TRANSLATORS: Purpose helptext for an Empire production site: Weapon Smithy
#: ../../../../data/tribes/initialization/empire/units.lua:1883
msgctxt "empire_building"
msgid ""
"Forges spears to equip the soldiers and to train their attack in the "
"training camp."
msgstr "Forja lanças para equipar os soldados e treinar seu ataque no acampamento de treinamento."

#. TRANSLATORS: Performance helptext for an Empire production site: Weapon
#. Smithy
#: ../../../../data/tribes/initialization/empire/units.lua:1885
msgctxt "empire_building"
msgid ""
"If this building is fully supplied and all spears are needed by the economy,"
" production of one of each spear takes %1$s on average. If only one kind of "
"spear is needed by the economy, production of one wooden spear takes %2$s, "
"one spear, one advanced spear, one heavy spear or one war spear takes %3$s "
"on average."
msgstr "Se esta construção estiver totalmente abastecida e todas as lanças forem necessárias à economia, a produção de uma de cada lança leva %1$s em média. Se apenas um tipo de lança for necessário à economia, a produção de uma lança de madeira leva %2$s, e uma lança, uma lança avançada, uma lança pesada ou uma lança de guerra leva %3$s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "He who hurts writes in the wind, he who is hurt in marble."
#: ../../../../data/tribes/initialization/empire/units.lua:1897
msgid "In vento scribit lædens, in marmore læsus."
msgstr "In vento scribit lædens, in marmore læsus."

#. TRANSLATORS: Lore helptext for an Empire production site: Marble Mine
#. Translation for the classical Latin quote:
#. "In vento scribit lædens, in marmore læsus."
#: ../../../../data/tribes/initialization/empire/units.lua:1901
msgid "He who hurts writes in the wind, he who is hurt in marble."
msgstr "Quem fere escreve no vento; quem é ferido, no mármore."

#. TRANSLATORS: Purpose helptext for an Empire production site: Marble Mine
#. TRANSLATORS: Purpose helptext for an Empire production site: Deep Marble
#. Mine
#: ../../../../data/tribes/initialization/empire/units.lua:1906
#: ../../../../data/tribes/initialization/empire/units.lua:1929
msgctxt "empire_building"
msgid "Carves marble and granite out of the rock in mountain terrain."
msgstr "Extrai mármore e granito da rocha em terreno montanhoso."

#. TRANSLATORS: Performance helptext for an Empire production site: Marble
#. Mine
#. TRANSLATORS: Performance helptext for an Empire production site: Deep
#. Marble Mine
#: ../../../../data/tribes/initialization/empire/units.lua:1908
#: ../../../../data/tribes/initialization/empire/units.lua:1931
msgctxt "empire_building"
msgid ""
"If the food supply is steady, this mine can produce marble in %1$s and "
"granite in %2$s on average."
msgstr "Se o suprimento de comida for constante, esta mina pode produzir mármore em %1$s e granito em %2$s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "He found a city of brick, and left it one of marble."
#: ../../../../data/tribes/initialization/empire/units.lua:1918
msgid "Urbem lateritiam invenit, marmoream reliquit."
msgstr "Urbem lateritiam invenit, marmoream reliquit."

#. TRANSLATORS: Lore helptext for an Empire production site: Deep Marble Mine
#. Translation for the classical Latin quote:
#. "Urbem lateritiam invenit, marmoream reliquit."
#: ../../../../data/tribes/initialization/empire/units.lua:1922
msgid "He found a city of brick, and left it one of marble."
msgstr "Encontrou uma cidade de tijolos e a deixou de mármore."

#. TRANSLATORS: Lore author helptext for an Empire production site: Deep
#. Marble Mine
#: ../../../../data/tribes/initialization/empire/units.lua:1926
msgctxt "empire_building"
msgid "History of the Empire, Part VI on the return of Lutius to Fremil"
msgstr "História do Império, Parte VI, sobre o retorno de Lutius a Fremil"

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Coal is revived from the dead, it turns from black to red, creates embers,
#. and as it falls apart, it becomes ashes."
#: ../../../../data/tribes/initialization/empire/units.lua:1942
msgid ""
"Carbo de mortuo reviviscit, de nigro in ruborem vertitur, favillas generat, "
"et dum resolvitur, cinerea."
msgstr "Carbo de mortuo reviviscit, de nigro in ruborem vertitur, favillas generat, et dum resolvitur, cinerea."

#. TRANSLATORS: Lore helptext for an Empire production site: Coal Mine
#. Translation for the classical Latin quote:
#. "Carbo de mortuo reviviscit, de nigro in ruborem vertitur, favillas
#. generat,
#. et dum resolvitur, cinerea."
#: ../../../../data/tribes/initialization/empire/units.lua:1948
msgid ""
"Coal is revived from the dead, it turns from black to red, creates embers, "
"and as it falls apart, it becomes ashes."
msgstr "O carvão revive dos mortos, transforma-se de preto em vermelho, cria brasas e, ao se desfazer, torna-se cinzas."

#. TRANSLATORS: Performance helptext for an Empire production site: Coal Mine
#. TRANSLATORS: Performance helptext for an Empire production site: Deep Coal
#. Mine
#: ../../../../data/tribes/initialization/empire/units.lua:1956
#: ../../../../data/tribes/initialization/empire/units.lua:1981
#, lua-format
msgctxt "empire_building"
msgid ""
"If the food supply is steady, this mine can produce coal in %s on average."
msgstr "Se o suprimento de comida for constante, esta mina pode produzir carvão em %s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "For there are more types of fire: for coal and flame are different, and
#. the type
#. that gives light, all of them are fire."
#: ../../../../data/tribes/initialization/empire/units.lua:1967
msgid ""
"Non enim est una species ignis: nam diversum est carbo et flamma, et lux "
"specie, cum unumquodque horum sit ignis."
msgstr "Non enim est una species ignis: nam diversum est carbo et flamma, et lux specie, cum unumquodque horum sit ignis."

#. TRANSLATORS: Lore helptext for an Empire production site: Deep Coal Mine
#. Translation for the classical Latin quote:
#. "Non enim est una species ignis: nam diversum est carbo et flamma, et lux
#. specie,
#. cum unumquodque horum sit ignis."
#: ../../../../data/tribes/initialization/empire/units.lua:1973
msgid ""
"For there are more types of fire: for coal and flame are different, and the "
"type that gives light, all of them are fire."
msgstr "Pois há mais tipos de fogo: pois carvão e chama são diferentes, e o tipo que dá luz — todos eles são fogo."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Iron is sharpened by iron."
#: ../../../../data/tribes/initialization/empire/units.lua:1991
msgid "Ferrum ferro acuitur."
msgstr "Ferrum ferro acuitur."

#. TRANSLATORS: Lore helptext for an Empire production site: Iron Mine
#. Translation for the classical Latin quote:
#. "Ferrum ferro acuitur."
#: ../../../../data/tribes/initialization/empire/units.lua:1995
msgid "Iron is sharpened by iron."
msgstr "O ferro é afiado pelo ferro."

#. TRANSLATORS: Lore author helptext for an Empire production site: Iron Mine
#: ../../../../data/tribes/initialization/empire/units.lua:1998
msgctxt "empire_building"
msgid "A proverb that is vehemently disputed by iron miners"
msgstr "Um provérbio que é veementemente contestado pelos mineradores de ferro"

#. TRANSLATORS: Performance helptext for an Empire production site: Iron Mine
#. TRANSLATORS: Performance helptext for an Empire production site: Deep Iron
#. Mine
#: ../../../../data/tribes/initialization/empire/units.lua:2002
#: ../../../../data/tribes/initialization/empire/units.lua:2025
#, lua-format
msgctxt "empire_building"
msgid ""
"If the food supply is steady, this mine can produce iron ore in %s on "
"average."
msgstr "Se o suprimento de comida for constante, esta mina pode produzir minério de ferro em %s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "By constant use an iron ring is worn away."
#: ../../../../data/tribes/initialization/empire/units.lua:2012
msgid "Ferreus assiduo consumitur annulus usu."
msgstr "Ferreus assiduo consumitur annulus usu."

#. TRANSLATORS: Lore helptext for an Empire production site: Deep Iron Mine
#. Translation for the classical Latin quote:
#. "Ferreus assiduo consumitur annulus usu."
#: ../../../../data/tribes/initialization/empire/units.lua:2016
msgid "By constant use an iron ring is worn away."
msgstr "Pelo uso constante, um anel de ferro se desgasta."

#. TRANSLATORS: Lore author helptext for an Empire production site: Deep Iron
#. Mine
#: ../../../../data/tribes/initialization/empire/units.lua:2020
msgctxt "empire_building"
msgid "Amalea on the importance of always looking for more resources"
msgstr "Amalea sobre a importância de sempre procurar mais recursos"

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Gold discovered and all the better for being so."
#: ../../../../data/tribes/initialization/empire/units.lua:2035
msgid "Aurum irrepertum et sic melius situm."
msgstr "Aurum irrepertum et sic melius situm."

#. TRANSLATORS: Lore helptext for an Empire production site: Gold Mine
#. Translation for the classical Latin quote:
#. "Aurum irrepertum et sic melius situm."
#: ../../../../data/tribes/initialization/empire/units.lua:2039
msgid "Gold discovered and all the better for being so."
msgstr "Ouro descoberto — e tanto melhor por isso."

#. TRANSLATORS: Lore author helptext for an Empire production site: Gold Mine
#: ../../../../data/tribes/initialization/empire/units.lua:2043
msgctxt "empire_building"
msgid ""
"Amalea receiving the first geologist report of gold on the small island"
msgstr "Amalea recebendo o primeiro relatório do geólogo sobre ouro na pequena ilha"

#. TRANSLATORS: Performance helptext for an Empire production site: Gold Mine
#: ../../../../data/tribes/initialization/empire/units.lua:2048
#: ../../../../data/tribes/initialization/empire/units.lua:2071
#, lua-format
msgctxt "empire_building"
msgid ""
"If the food supply is steady, this mine can produce gold ore in %s on "
"average."
msgstr "Se o suprimento de comida for constante, esta mina pode produzir minério de ouro em %s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Gold has conquered the fear of death."
#: ../../../../data/tribes/initialization/empire/units.lua:2058
msgid "Formidinem mortis vicit aurum."
msgstr "Formidinem mortis vicit aurum."

#. TRANSLATORS: Lore helptext for an Empire production site: Deep Gold Mine
#. Translation for the classical Latin quote:
#. "Formidinem mortis vicit aurum."
#: ../../../../data/tribes/initialization/empire/units.lua:2062
msgid "Gold has conquered the fear of death."
msgstr "O ouro venceu o medo da morte."

#. TRANSLATORS: Lore author helptext for an Empire production site: Deep Gold
#. Mine
#: ../../../../data/tribes/initialization/empire/units.lua:2066
msgctxt "empire_building"
msgid "General Trepidus Egenus Attenuatus on motivating soldiers"
msgstr "General Trepidus Egenus Attenuatus sobre motivar soldados"

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "[The People of the Empire] who once handed out all [power], now restrains
#. itself
#. and anxiously hopes for just two things: bread and games."
#: ../../../../data/tribes/initialization/empire/units.lua:2084
msgid ""
"Qui dabat olim […] omnia, nunc se continet atque duas tantum res anxius "
"optat, panem et circenses."
msgstr "Qui dabat olim […] omnia, nunc se continet atque duas tantum res anxius optat, panem et circenses."

#. TRANSLATORS: Lore helptext for an Empire training site: Arena
#. Translation for the classical Latin quote:
#. "Qui dabat olim […] omnia, nunc se continet atque duas tantum res anxius
#. optat,
#. panem et circenses."
#: ../../../../data/tribes/initialization/empire/units.lua:2090
msgid ""
"[The People of the Empire] who once handed out all [power], now restrains "
"itself and anxiously hopes for just two things: bread and games."
msgstr "[O Povo do Império] que outrora distribuía todo [o poder], agora se contém e ansiosamente espera por apenas duas coisas: pão e jogos."

#. TRANSLATORS: Lore author helptext for an Empire training site: Arena
#: ../../../../data/tribes/initialization/empire/units.lua:2094
msgctxt "empire_building"
msgid "History of the Empire, Part X – the decline"
msgstr "História do Império, Parte X – o declínio"

#. TRANSLATORS: Purpose helptext for an Empire training site: Arena, part 1
#. TRANSLATORS: Purpose helptext for an Empire training site: Colosseum, part
#. 1
#: ../../../../data/tribes/initialization/empire/units.lua:2097
#: ../../../../data/tribes/initialization/empire/units.lua:2124
msgctxt "empire_building"
msgid "Trains soldiers in ‘Evade’."
msgstr "Treinar soldados para \"Escapar\"."

#. TRANSLATORS: Purpose helptext for an Empire training site: Arena, part 2
#. TRANSLATORS: Purpose helptext for an Empire training site: Colosseum, part
#. 2
#: ../../../../data/tribes/initialization/empire/units.lua:2099
#: ../../../../data/tribes/initialization/empire/units.lua:2126
msgctxt "empire_building"
msgid ""
"‘Evade’ increases the soldier’s chance not to be hit by the enemy and so to "
"remain totally unaffected."
msgstr "\"Escapar\" aumenta a chance do soldado não ser atingido pelo inimigo e então permanecer totalmente não afetado."

#. TRANSLATORS: Note helptext for an Empire training site: Arena
#. TRANSLATORS: Note helptext for an Empire training site: Colosseum
#. TRANSLATORS: Note helptext for an Empire training site: Training Camp
#: ../../../../data/tribes/initialization/empire/units.lua:2102
#: ../../../../data/tribes/initialization/empire/units.lua:2129
#: ../../../../data/tribes/initialization/empire/units.lua:2162
msgctxt "empire_building"
msgid ""
"Imperial soldiers cannot be trained in ‘Defense’ and will remain at the "
"level with which they came."
msgstr "Os soldados imperiais não podem ser treinados em ‘Defesa’ e permanecerão no nível com que vieram."

#. TRANSLATORS: Performance helptext for an Empire training site: Arena
#: ../../../../data/tribes/initialization/empire/units.lua:2104
#, lua-format
msgctxt "empire_building"
msgid ""
"If all needed wares are delivered in time, an arena can train one soldier to"
" the first level in evade in %s on average."
msgstr "Se todas as mercadorias necessárias forem entregues a tempo, uma arena pode treinar um soldado até o primeiro nível de esquiva em %s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Hail Cæsar! Those who are about to die greet you!"
#: ../../../../data/tribes/initialization/empire/units.lua:2114
msgid "Ave Cæsar! Morituri te salutant!"
msgstr "Ave Cæsar! Morituri te salutant!"

#. TRANSLATORS: Lore helptext for an Empire training site: Colosseum
#. Translation for the classical Latin quote:
#. "Ave Cæsar! Morituri te salutant!"
#: ../../../../data/tribes/initialization/empire/units.lua:2118
msgid "Hail Cæsar! Those who are about to die greet you!"
msgstr "Ave, César! Os que estão prestes a morrer o saúdam!"

#. TRANSLATORS: Lore author helptext for an Empire training site: Colosseum
#: ../../../../data/tribes/initialization/empire/units.lua:2121
msgctxt "empire_building"
msgid "Greeting from the gladiators to the emperor"
msgstr "Saudação dos gladiadores ao imperador"

#. TRANSLATORS: Performance helptext for an Empire training site: Colosseum,
#. part 1
#: ../../../../data/tribes/initialization/empire/units.lua:2132
#, lua-format
msgctxt "empire_building"
msgid ""
"If all needed wares are delivered in time, a colosseum can train one soldier"
" one level in evade in %s on average."
msgstr "Se todas as mercadorias necessárias forem entregues a tempo, um coliseu pode treinar um soldado um nível de esquiva em %s em média."

#. TRANSLATORS: Performance helptext for an Empire training site: Colosseum,
#. part 2
#. TRANSLATORS: Performance helptext for an Empire training site: Training
#. Camp, part 2
#: ../../../../data/tribes/initialization/empire/units.lua:2134
#: ../../../../data/tribes/initialization/empire/units.lua:2167
#, lua-format
msgctxt "empire_building"
msgid "Complete training of one soldier takes %s on average."
msgstr "O treinamento completo de um soldado leva %s em média."

#. TRANSLATORS: DO NOT TRANSLATE, but you may transliterate into non-latin
#. fonts.
#. Classical Latin quote meaning:
#. "Fortune helps the strong."
#: ../../../../data/tribes/initialization/empire/units.lua:2145
