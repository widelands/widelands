#: ../../../../data/tribes/initialization/empire/units.lua:939
#: ../../../../data/tribes/initialization/frisians/units.lua:1276
msgid "There are no resources in the ground here."
msgstr "Aici nu există resurse în pământ."

#. TRANSLATORS: Helptext for an Amazon resource indicator: Gold, part 1
#: ../../../../data/tribes/initialization/amazons/units.lua:1209
#: ../../../../data/tribes/initialization/amazons/units.lua:1231
msgid ""
"Gold veins contain gold ore that can be washed from the gravel at gold "
"digger dwellings."
msgstr "Filoanele de aur conțin minereu de aur, care poate fi spălat din pietriș în locuințele căutătorilor de aur."

#. TRANSLATORS: Helptext for an Amazon resource indicator: Gold, part 2
