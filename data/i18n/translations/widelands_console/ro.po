#. * TRANSLATORS: Separator for alternative values for command line parameters
#: ../../../../src/wlapplication_messages.cc:52
#, c-format
msgid "%1$s|%2$s"
msgstr "%1$s|%2$s"

#: ../../../../src/wlapplication_messages.cc:55
#: ../../../../src/wlapplication_messages.cc:87
#: ../../../../src/wlapplication_messages.cc:92
#: ../../../../src/wlapplication_messages.cc:113
msgid "FILENAME"
msgstr "FIȘIER"

#. * TRANSLATORS: Used instead of a file name indicating last savegame, replay
#. or map.
#. Use '_' instead of spaces if you need multiple words and don't use
#. punctuation marks
#: ../../../../src/wlapplication_messages.cc:60
msgid "last"
msgstr "ultimul"

#: ../../../../src/wlapplication_messages.cc:66
msgid "Usage:"
msgstr "Utilizare:"

#: ../../../../src/wlapplication_messages.cc:66
msgid "widelands <option0>=<value0> ... <optionN>=<valueN>"
msgstr "widelands <opțiune0>=<valoare0> ... <opțiuneN>=<valoareN>"

#: ../../../../src/wlapplication_messages.cc:67
msgid "widelands <save.wgf>/<replay.wry>"
msgstr "widelands <salvare.wgf>/<reluare.wry>"

#: ../../../../src/wlapplication_messages.cc:69
#: ../../../../src/wlapplication_messages.cc:71
#: ../../../../src/wlapplication_messages.cc:76
#: ../../../../src/wlapplication_messages.cc:250
msgid "DIRNAME"
msgstr "DIRECTOR"

#: ../../../../src/wlapplication_messages.cc:69
msgid "Options:"
msgstr "Opțiuni:"

#: ../../../../src/wlapplication_messages.cc:70
msgid "Use the specified directory for the Widelands data files."
msgstr "Folosește directorul specificat pentru fișierele de date Widelands."

#: ../../../../src/wlapplication_messages.cc:72
#, c-format
msgid ""
"Use the specified directory for Widelands config files, savegames, and "
"replays. Default is `%s`."
msgstr "Folosește directorul specificat pentru fișierele de configurare, jocurile salvate și reluările Widelands. Implicit este `%s`."

#: ../../../../src/wlapplication_messages.cc:77
msgid "Use the specified directory for the Widelands locale files."
msgstr "Folosește directorul specificat pentru fișierele de localizare Widelands."

#: ../../../../src/wlapplication_messages.cc:81
msgid "Use the specified locale."
msgstr "Folosește limba (locale) specificată."

#. * TRANSLATORS: The … is not used on purpose to increase readability on
#. monospaced terminals
#: ../../../../src/wlapplication_messages.cc:81
msgid "[de_DE|sv_SE|...]"
msgstr "[de_DE|sv_SE|...]"

#: ../../../../src/wlapplication_messages.cc:83
msgid ""
"Do not check whether the data directory to use is compatible with this "
"Widelands version."
msgstr "Nu verifica dacă directorul de date folosit este compatibil cu această versiune Widelands."

#: ../../../../src/wlapplication_messages.cc:88
#, c-format
msgid ""
"Create a new game directly with the settings configured in the given file. "
"An example can be found in `%s`."
msgstr "Creează direct un joc nou cu setările configurate în fișierul dat. Un exemplu găsești în `%s`."

#: ../../../../src/wlapplication_messages.cc:93
msgid "Start the map `FILENAME` directly as a singleplayer scenario."
msgstr "Pornește direct harta `FIȘIER` ca scenariu pentru un singur jucător."

#. * TRANSLATORS: %1 is translation for FILENAME,
#. %2 is translation for "last" for last used file
#: ../../../../src/wlapplication_messages.cc:97
#, c-format
msgid ""
"Load the savegame `%1$s` directly or the last saved game if `=%2$s` is used."
msgstr "Încarcă direct jocul salvat `%1$s` sau ultimul joc salvat, dacă se folosește `=%2$s`."

#. * TRANSLATORS: %1 is translation for FILENAME,
#. %2 is translation for "last" for last used file
#: ../../../../src/wlapplication_messages.cc:103
#, c-format
msgid ""
"Load the replay `%1$s` directly or the last saved replay if `=%2$s` is used."
msgstr "Încarcă direct reluarea `%1$s` sau ultima reluare salvată, dacă se folosește `=%2$s`."

#. * TRANSLATORS: %1 is translation for FILENAME,
#. %2 is translation for "last" for last used file
#: ../../../../src/wlapplication_messages.cc:109
#, c-format
msgid ""
"Start the Widelands map editor directly. You can add `=%1$s` to directly "
"load the map `FILENAME` in the editor or `=%2$s` to load the last edited "
"map."
msgstr "Pornește direct editorul de hărți Widelands. Poți adăuga `=%1$s` pentru a încărca direct harta `FIȘIER` în editor sau `=%2$s` pentru a încărca ultima hartă editată."

#: ../../../../src/wlapplication_messages.cc:114
msgid ""
"Run the given Lua script after initialization. Only valid with --scenario, "
"--loadgame, or --editor."
msgstr "Rulează scriptul Lua dat după inițializare. Valabil doar cu --scenario, --loadgame sau --editor."

#. * TRANSLATORS: A placeholder for a numerical value
#: ../../../../src/wlapplication_messages.cc:120
#: ../../../../src/wlapplication_messages.cc:138
#: ../../../../src/wlapplication_messages.cc:155
#: ../../../../src/wlapplication_messages.cc:158
#: ../../../../src/wlapplication_messages.cc:177
#: ../../../../src/wlapplication_messages.cc:205
#: ../../../../src/wlapplication_messages.cc:209
#: ../../../../src/wlapplication_messages.cc:221
#: ../../../../src/wlapplication_messages.cc:255
#: ../../../../src/wlapplication_messages.cc:265
#: ../../../../src/wlapplication_messages.cc:270
msgid "n"
msgstr "n"

#. * TRANSLATORS: `n` references a numerical placeholder
#: ../../../../src/wlapplication_messages.cc:122
msgid "Start the scenario with difficulty `n`. Only valid with --scenario."
msgstr "Pornește scenariul cu dificultatea `n`. Valabil doar cu --scenario."

#: ../../../../src/wlapplication_messages.cc:124
msgid "Start the game with sound disabled."
msgstr "Pornește jocul cu sunetul dezactivat."

#: ../../../../src/wlapplication_messages.cc:125
msgid "Start the game with shuffle mode for playback of songs"
msgstr "Pornește jocul cu redarea melodiilor în ordine aleatorie"

#. * TRANSLATORS: You may translate true/false, also as on/off or yes/no, but
#. * TRANSLATORS: it HAS TO BE CONSISTENT with the translation in the
#. widelands textdomain.
#. * TRANSLATORS: * marks the default value
#: ../../../../src/wlapplication_messages.cc:129
#: ../../../../src/wlapplication_messages.cc:161
#: ../../../../src/wlapplication_messages.cc:172
#: ../../../../src/wlapplication_messages.cc:174
#: ../../../../src/wlapplication_messages.cc:180
#: ../../../../src/wlapplication_messages.cc:189
#: ../../../../src/wlapplication_messages.cc:202
#: ../../../../src/wlapplication_messages.cc:244
#: ../../../../src/wlapplication_messages.cc:253
msgid "[true*|false]"
msgstr "[adevărat*|fals]"

#: ../../../../src/wlapplication_messages.cc:130
msgid "Play the intro music at startup and show splash image until it ends."
msgstr "Redă muzica de introducere la pornire și afișează imaginea de start până se termină."

#: ../../../../src/wlapplication_messages.cc:131
msgid "Force Widelands to crash when a Lua error occurs."
msgstr "Forțează închiderea cu eroare a Widelands când apare o eroare Lua."

#: ../../../../src/wlapplication_messages.cc:133
msgid ""
"Force Widelands to crash when a game or the editor terminates with an error."
msgstr "Forțează închiderea cu eroare a Widelands când un joc sau editorul se termină cu o eroare."

#. * TRANSLATORS: Placeholder for a time value in seconds
#: ../../../../src/wlapplication_messages.cc:136
msgid "<seconds>"
msgstr "<secunde>"

#: ../../../../src/wlapplication_messages.cc:137
msgid ""
"Automatically close modal message boxes after the given number of seconds "
"time."
msgstr "Închide automat casetele de mesaj modale după numărul dat de secunde."

#: ../../../../src/wlapplication_messages.cc:138
msgid "Delete replays automatically after `n` weeks."
msgstr "Șterge automat reluările după `n` săptămâni."

#: ../../../../src/wlapplication_messages.cc:140
msgid ""
"Enable AI training mode. See https://www.widelands.org/wiki/Ai%20Training/ "
"for a full description of the AI training logic."
msgstr "Activează modul de antrenare a IA. Vezi https://www.widelands.org/wiki/Ai%20Training/ pentru o descriere completă a logicii de antrenare a IA."

#: ../../../../src/wlapplication_messages.cc:144
msgid ""
"Constantly adjust the game speed automatically depending on AI delay. Only "
"to be used for AI testing or training (in conjunction with --ai_training)."
msgstr "Ajustează automat și continuu viteza jocului în funcție de întârzierea IA. De folosit doar pentru testarea sau antrenarea IA (împreună cu --ai_training)."

#: ../../../../src/wlapplication_messages.cc:149
msgid "Enable the Script Console and Cheating Mode."
msgstr "Activează consola de scripturi și modul de trișare."

#: ../../../../src/wlapplication_messages.cc:151
msgid "Game options:"
msgstr "Opțiuni de joc:"

#: ../../../../src/wlapplication_messages.cc:151
msgid "Note: New values will be written to the config file."
msgstr "Notă: valorile noi vor fi scrise în fișierul de configurare."

#. * TRANSLATORS: `n` references a numerical placeholder
#: ../../../../src/wlapplication_messages.cc:157
msgid "Automatically save each `n` minutes."
msgstr "Salvează automat la fiecare `n` minute."

#. * TRANSLATORS: `n` references a numerical placeholder
#: ../../../../src/wlapplication_messages.cc:160
msgid "Use `n` files for rolling autosaves."
msgstr "Folosește `n` fișiere pentru salvările automate prin rotație."

#: ../../../../src/wlapplication_messages.cc:162
msgid ""
"Do not create an autosave when the user has been inactive since the last "
"autosave."
msgstr "Nu crea o salvare automată dacă utilizatorul a fost inactiv de la ultima salvare automată."

#: ../../../../src/wlapplication_messages.cc:164
msgid "Do not save files as binary zip archives."
msgstr "Nu salva fișierele ca arhive zip binare."

#: ../../../../src/wlapplication_messages.cc:165
msgid "Save files as binary zip archives."
msgstr "Salvează fișierele ca arhive zip binare."

#. * TRANSLATORS: You may translate true/false, also as on/off or yes/no, but
#. * TRANSLATORS: it HAS TO BE CONSISTENT with the translation in the
#. widelands textdomain.
#. * TRANSLATORS: * marks the default value
#: ../../../../src/wlapplication_messages.cc:170
#: ../../../../src/wlapplication_messages.cc:194
#: ../../../../src/wlapplication_messages.cc:196
#: ../../../../src/wlapplication_messages.cc:198
#: ../../../../src/wlapplication_messages.cc:200
#: ../../../../src/wlapplication_messages.cc:201
#: ../../../../src/wlapplication_messages.cc:216
#: ../../../../src/wlapplication_messages.cc:248
#: ../../../../src/wlapplication_messages.cc:260
msgid "[true|false*]"
msgstr "[adevărat|fals*]"

#: ../../../../src/wlapplication_messages.cc:171
msgid "Whether to save the history of sent chat messages to a file."
msgstr "Dacă se salvează într-un fișier istoricul mesajelor de chat trimise."

#: ../../../../src/wlapplication_messages.cc:173
msgid "Show filenames in the replay screen."
msgstr "Afișează numele fișierelor în ecranul de reluări."

#: ../../../../src/wlapplication_messages.cc:175
msgid ""
"Whether a warning should be shown in the editor if there are too many "
"players."
msgstr "Dacă în editor se afișează un avertisment când sunt prea mulți jucători."

#. * TRANSLATORS: `n` references a numerical placeholder
#: ../../../../src/wlapplication_messages.cc:179
msgid "Pause the game after `n` minutes of user inactivity."
msgstr "Pune jocul pe pauză după `n` minute de inactivitate a utilizatorului."

#: ../../../../src/wlapplication_messages.cc:181
msgid "Start building a road after placing a flag."
msgstr "Începe construirea unui drum după plasarea unui steag."

#: ../../../../src/wlapplication_messages.cc:185
msgid "Bitmask of display flags to set for new games."
msgstr "Masca de biți a opțiunilor de afișare pentru jocurile noi."

#. * TRANSLATORS: The … character is not used on purpose to increase
#. readability on monospaced
#. terminals
#: ../../../../src/wlapplication_messages.cc:185
#: ../../../../src/wlapplication_messages.cc:204
#: ../../../../src/wlapplication_messages.cc:212
#: ../../../../src/wlapplication_messages.cc:213
#: ../../../../src/wlapplication_messages.cc:214
#: ../../../../src/wlapplication_messages.cc:215
#: ../../../../src/wlapplication_messages.cc:218
msgid "[...]"
msgstr "[...]"

#: ../../../../src/wlapplication_messages.cc:195
msgid "Scroll when the mouse cursor is near the screen edge."
msgstr "Derulează când cursorul mouse-ului este aproape de marginea ecranului."

#: ../../../../src/wlapplication_messages.cc:197
msgid "Invert click-and-drag map movement direction."
msgstr "Inversează direcția de mișcare a hărții la clic și tragere."

#: ../../../../src/wlapplication_messages.cc:199
msgid "Allow diagonal scrolling with the numeric keypad."
msgstr "Permite derularea pe diagonală cu tastatura numerică."

#: ../../../../src/wlapplication_messages.cc:200
msgid "Display system time in the info panel."
msgstr "Afișează ora sistemului în panoul de informații."

#: ../../../../src/wlapplication_messages.cc:201
msgid "Use single watchwindow mode."
msgstr "Folosește modul cu o singură fereastră de urmărire."

#: ../../../../src/wlapplication_messages.cc:203
msgid "Show in-game chat with transparent background."
msgstr "Afișează chatul din joc cu fundal transparent."

#: ../../../../src/wlapplication_messages.cc:204
msgid "Bitmask to set the toolbar location and mode."
msgstr "Masca de biți pentru poziția și modul barei de instrumente."

#: ../../../../src/wlapplication_messages.cc:205
msgid "Default pagesize for paginated structures."
msgstr "Dimensiunea implicită a paginii pentru structurile paginate."

#: ../../../../src/wlapplication_messages.cc:207
msgid "Networking:"
msgstr "Rețea:"

#: ../../../../src/wlapplication_messages.cc:207
msgid "URI"
msgstr "URI"

#: ../../../../src/wlapplication_messages.cc:208
msgid "Connect to a different metaserver for internet gaming."
msgstr "Conectează-te la un alt metaserver pentru jocul pe internet."

#. * TRANSLATORS: `n` references a numerical placeholder
#: ../../../../src/wlapplication_messages.cc:211
msgid "Port number `n` of the metaserver for internet gaming."
msgstr "Numărul de port `n` al metaserverului pentru jocul pe internet."

#: ../../../../src/wlapplication_messages.cc:212
msgid "The name of the last hosted game."
msgstr "Numele ultimului joc găzduit."

#: ../../../../src/wlapplication_messages.cc:213
msgid "The nickname used for LAN and online games."
msgstr "Pseudonimul folosit pentru jocurile în rețea locală (LAN) și online."

#: ../../../../src/wlapplication_messages.cc:214
msgid "Name of map author."
msgstr "Numele autorului hărții."

#: ../../../../src/wlapplication_messages.cc:215
msgid "The last host connected to."
msgstr "Ultima gazdă la care te-ai conectat."

#: ../../../../src/wlapplication_messages.cc:217
msgid "Whether the used metaserver login is for a registered user."
msgstr "Dacă autentificarea folosită pe metaserver este a unui utilizator înregistrat."

#: ../../../../src/wlapplication_messages.cc:218
msgid "The hashed password for online logins."
msgstr "Parola criptată (hash) pentru autentificările online."

#: ../../../../src/wlapplication_messages.cc:219
msgid "IP"
msgstr "IP"

#: ../../../../src/wlapplication_messages.cc:220
msgid "Connect to a different server address from the add-ons manager."
msgstr "Conectează managerul de suplimente la o altă adresă de server."

#: ../../../../src/wlapplication_messages.cc:222
msgid "Connect to a different server port from the add-ons manager."
msgstr "Conectează managerul de suplimente la un alt port de server."

#. * TRANSLATORS: A syncstream is a synchronization stream. Syncstreams are
#. used in
#. * multiplayer
#. * TRANSLATORS: games to make sure that there is no mismatch between the
#. players.
#: ../../../../src/wlapplication_messages.cc:228
msgid "Create syncstream dump files to help debug network games."
msgstr "Creează fișiere de descărcare a fluxului de sincronizare (syncstream) pentru depanarea jocurilor în rețea."

#: ../../../../src/wlapplication_messages.cc:231
msgid "Graphic options:"
msgstr "Opțiuni grafice:"

#: ../../../../src/wlapplication_messages.cc:231
msgid "Use the whole display for the game screen."
msgstr "Folosește tot ecranul pentru joc."

#: ../../../../src/wlapplication_messages.cc:233
msgid "Start the game in a maximized window."
msgstr "Pornește jocul într-o fereastră maximizată."

#. * TRANSLATORS: A placeholder for window width
#: ../../../../src/wlapplication_messages.cc:236
msgid "x"
msgstr "x"

#. * TRANSLATORS: `x` references a window width placeholder
#: ../../../../src/wlapplication_messages.cc:238
msgid "Width `x` of the window in pixel."
msgstr "Lățimea `x` a ferestrei, în pixeli."

#. * TRANSLATORS: A placeholder for window height
#: ../../../../src/wlapplication_messages.cc:241
msgid "y"
msgstr "y"

#. * TRANSLATORS: `y` references a window height placeholder
#: ../../../../src/wlapplication_messages.cc:243
msgid "Height `y` of the window in pixel."
msgstr "Înălțimea `y` a ferestrei, în pixeli."

#: ../../../../src/wlapplication_messages.cc:245
msgid ""
"Whether to let the system draw the mouse cursor. Disable it only if the "
"cursor doesn't appear right, or if you want it to be visible in screenshots "
"or screencasts."
msgstr "Dacă sistemul desenează cursorul mouse-ului. Dezactivează opțiunea doar dacă cursorul nu apare corect sau dacă vrei să fie vizibil în capturile sau înregistrările de ecran."

#: ../../../../src/wlapplication_messages.cc:248
msgid "Whether to use sticky tooltips."
msgstr "Dacă se folosesc sfaturi (tooltips) persistente."

#: ../../../../src/wlapplication_messages.cc:251
msgid ""
"The path to the active UI theme, relative to the Widelands home directory."
msgstr "Calea către tema activă a interfeței, relativă la directorul personal Widelands."

#: ../../../../src/wlapplication_messages.cc:253
msgid "Options for the internal window manager:"
msgstr "Opțiuni pentru managerul intern de ferestre:"

#: ../../../../src/wlapplication_messages.cc:254
msgid "Whether automatic map movements should be animated."
msgstr "Dacă mișcările automate ale hărții sunt animate."

#. * TRANSLATORS: `n` references a numerical placeholder
#: ../../../../src/wlapplication_messages.cc:257
msgid ""
"Move a window to the edge of the screen when the edge of the window comes "
"within a distance `n` from the edge of the screen."
msgstr "Mută o fereastră la marginea ecranului când marginea ferestrei ajunge la o distanță `n` de marginea ecranului."

#: ../../../../src/wlapplication_messages.cc:261
msgid ""
"Eliminate a window’s border towards the edge of the screen when the edge of "
"the window is next to the edge of the screen."
msgstr "Elimină bordura ferestrei dinspre marginea ecranului când marginea ferestrei este lipită de marginea ecranului."

#. * TRANSLATORS: `n` references a numerical placeholder
#: ../../../../src/wlapplication_messages.cc:267
msgid ""
"Move a window to the edge of the panel when the edge of the window comes "
"within a distance of `n` from the edge of the panel."
msgstr "Mută o fereastră la marginea panoului când marginea ferestrei ajunge la o distanță de `n` de marginea panoului."

#. * TRANSLATORS: `n` references a numerical placeholder
#: ../../../../src/wlapplication_messages.cc:272
msgid ""
"The factor by which to fractionally scale the Widelands user interface, in "
"quarters."
msgstr "Factorul de scalare fracționară a interfeței Widelands, în sferturi."

#: ../../../../src/wlapplication_messages.cc:275
msgid "Enable verbose debug messages"
msgstr "Activează mesajele detaliate de depanare"

#: ../../../../src/wlapplication_messages.cc:275
msgid "Others:"
msgstr "Altele:"

#: ../../../../src/wlapplication_messages.cc:277
msgid ""
"Print all strings as they are translated. This helps with tracing down bugs "
"with internationalization."
msgstr "Afișează toate textele pe măsură ce sunt traduse. Ajută la depistarea erorilor de internaționalizare."

#: ../../../../src/wlapplication_messages.cc:280
msgid "Only print version and exit."
msgstr "Afișează doar versiunea și ieși."

#: ../../../../src/wlapplication_messages.cc:281
msgid "Show this help."
msgstr "Afișează acest ajutor."

#: ../../../../src/wlapplication_messages.cc:282
msgid "Show this help with all available config options."
msgstr "Afișează acest ajutor cu toate opțiunile de configurare disponibile."

#: ../../../../src/wlapplication_messages.cc:283
msgid "<save.wgf>/<replay.wry>"
msgstr "<salvare.wgf>/<reluare.wry>"

#: ../../../../src/wlapplication_messages.cc:284
msgid ""
"Load the given savegame or replay directly. Useful for .wgf/.wry file "
"extension association. Does not work with other options. Also see "
"--loadgame/--replay."
msgstr "Încarcă direct jocul salvat sau reluarea dată. Util pentru asocierea extensiilor de fișier .wgf/.wry. Nu funcționează împreună cu alte opțiuni. Vezi și --loadgame/--replay."

#. * TRANSLATORS: %s = version information
#: ../../../../src/wlapplication_messages.cc:319
#, c-format
msgid "This is Widelands version %s"
msgstr "Aceasta este versiunea Widelands %s"

#: ../../../../src/wlapplication_messages.cc:377
msgid ""
"Bug reports? Suggestions? Check out the project website:\n"
"        https://www.widelands.org/\n"
"\n"
"Hope you enjoy this game!"
msgstr "Raportezi o eroare? Ai sugestii? Vizitează site-ul proiectului:\n        https://www.widelands.org/\n\nSperăm să te bucuri de acest joc!"
